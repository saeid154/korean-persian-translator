# Copy this file to .env for local development.
# In production (Render, Fly, etc.) set these as real environment variables /
# secrets in the host's dashboard instead of committing a .env file.

# From https://platform.openai.com/api-keys (sign up with email or an
# existing Google account - no Microsoft account needed). You'll need to
# add a small prepaid balance to your OpenAI account for the API to work.
OPENAI_API_KEY=sk-your-openai-api-key

# A long random passphrase only you know. The web app asks for this once and
# sends it on every API call so strangers can't use your OpenAI key even if
# they find your app's URL. Generate one with: openssl rand -hex 24
APP_PASSWORD=choose-a-long-random-passphrase

PORT=3000
