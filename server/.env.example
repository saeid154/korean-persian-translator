# Copy this file to .env for local development.
# In production (Render, Fly, etc.) set these as real environment variables /
# secrets in the host's dashboard instead of committing a .env file.

# Azure Speech resource (Speech to Text) - create at https://portal.azure.com
# Free tier (F0) gives 5 audio hours/month forever.
AZURE_SPEECH_KEY=your-azure-speech-resource-key
AZURE_SPEECH_REGION=eastus

# Azure Translator resource (Text Translation) - can be the same or a
# different Azure resource than Speech. Free tier (F0) gives 2,000,000
# characters/month forever.
AZURE_TRANSLATOR_KEY=your-azure-translator-resource-key
AZURE_TRANSLATOR_REGION=eastus

# A long random passphrase only you know. The web app asks for this once and
# sends it on every API call so strangers can't use your Azure keys even if
# they find your app's URL. Generate one with: openssl rand -hex 24
APP_PASSWORD=choose-a-long-random-passphrase

PORT=3000
